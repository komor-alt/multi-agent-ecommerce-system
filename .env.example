# Copy this file to the repository-root .env for local Docker Compose use.
# Never commit .env or put a real API key in this template.
ECOM_EMBEDDING_PROVIDER=qwen
ECOM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
ECOM_EMBEDDING_API_KEY=
ECOM_EMBEDDING_MODEL=text-embedding-v4
ECOM_EMBEDDING_DIMENSIONS=1024
ECOM_EMBEDDING_LIVE_ENABLED=false
ECOM_EMBEDDING_MAX_CALLS=0

# Recommendation LLM is deliberately disabled by default. Live calls require all
# three settings plus ECOM_LLM_API_KEY; keep real keys in a secret manager/local env.
ECOM_RECOMMEND_MODE=RULES
ECOM_RECOMMEND_LIVE_ENABLED=false
ECOM_RECOMMEND_MAX_LLM_CALLS=0
ECOM_SUPERVISOR_MAX_LLM_CALLS=0
ECOM_RECOMMEND_LLM_PROVIDER=openai-compatible
ECOM_RECOMMEND_LLM_TIMEOUT_MS=15000
ECOM_LLM_API_KEY=
ECOM_LLM_BASE_URL=https://api.deepseek.com
ECOM_LLM_MODEL=deepseek-v4-flash

# After-sales defaults to a deterministic local mock. Shopify mode is read-only;
# keep credentials in a local secret store and never commit them.
ECOM_AFTERSALES_CONNECTOR=mock
ECOM_SHOPIFY_SHOP_DOMAIN=
ECOM_SHOPIFY_ADMIN_ACCESS_TOKEN=
ECOM_SHOPIFY_API_VERSION=2026-10
ECOM_SHOPIFY_CONNECT_TIMEOUT_MS=2000
ECOM_SHOPIFY_READ_TIMEOUT_MS=5000
ECOM_SHOPIFY_WRITE_ENABLED=false
ECOM_SHOPIFY_ALLOWED_WRITE_ACTIONS=

# Local-only defaults. Production: NODE_ENV=production, AUTH_MODE=required,
# Spring profile production, HTTPS exact origins and secrets supplied by a secret manager.
ECOM_NODE_ENV=development
AUTH_MODE=demo
AUTH_JWT_SECRET=
AUTH_ACCOUNTS_JSON=[]
AUTH_ALLOWED_ORIGINS=http://localhost:5173
ECOM_INTERNAL_API_AUTH_ENABLED=false
JAVA_INTERNAL_SERVICE_TOKEN=
ECOM_AGENT_RUN_TIMEOUT=60s
ECOM_OUTBOUND_CONNECT_TIMEOUT=3s
ECOM_OUTBOUND_READ_TIMEOUT=15s
ECOM_AGENT_MAX_CONCURRENT_RUNS=12
# New read-only recommendation runs only; max attempts includes the first execution.
ECOM_AGENT_RECOVERY_ENABLED=true
ECOM_AGENT_RECOVERY_LEASE_DURATION=30s
ECOM_AGENT_RECOVERY_HEARTBEAT_INTERVAL=5s
ECOM_AGENT_RECOVERY_RENEWAL_TIMEOUT_SECONDS=3
ECOM_AGENT_RECOVERY_SCAN_INTERVAL=1s
ECOM_AGENT_RECOVERY_BATCH_SIZE=16
ECOM_AGENT_RECOVERY_MAX_ATTEMPTS=3
ECOM_AGENT_OUTBOX_LEASE_MS=60000
ECOM_AGENT_OUTBOX_SCAN_MS=250
ECOM_AGENT_OUTBOX_BATCH_SIZE=200
